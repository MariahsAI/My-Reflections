{
  "name": "Reflections",
  "short_name": "Reflections",
  "description": "Toggle your reality. Your story, made into sound and film.",
  "id": "./app.html",
  "start_url": "./app.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0c0912",
  "theme_color": "#0c0912",
  "categories": ["music", "social", "entertainment"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Make a song", "url": "./app.html#create", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Song for someone", "url": "./app.html#gift", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Daily prompt", "url": "./app.html#daily", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
